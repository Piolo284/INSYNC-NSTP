# Copy to .env and fill in.
# For production replace with your real values:
#   MONGODB_URI=YOUR_REAL_MONGODB_ATLAS_URI
#   API_BASE_URL=YOUR_REAL_API_URL
MONGODB_URI=mongodb://127.0.0.1:27017/nstp_management_system
PORT=5000
API_BASE_URL=http://localhost:5000/api

JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

ATTENDANCE_LATE_GRACE_MINUTES=15
ATTENDANCE_CODE_TTL_MINUTES=15

GRADE_WEIGHT_MODULES=30
GRADE_WEIGHT_ACTIVITIES=40
GRADE_WEIGHT_ATTENDANCE=30
GRADE_PASSING=75
GRADE_WARNING=70

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MARSU NSTP Portal <no-reply@marsu.edu.ph>
