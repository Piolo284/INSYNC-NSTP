# Copy to .env and fill in.
# Both the database and uploaded files live in MongoDB — records are plain
# documents, and files (documents, certificates, module files, photos) are
# streamed into GridFS. MONGODB_URI may point at a local instance or a
# cloud-hosted one (e.g. Atlas); GridFS works the same either way.
MONGODB_URI=mongodb://127.0.0.1:27017/marsu_nstp_portal
# Database to use (overrides any name in the URI; Atlas URIs often have none).
MONGODB_DB_NAME=nstp_management_system
PORT=5000
API_BASE_URL=http://localhost:5000/api

JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

MAX_UPLOAD_MB=15

ATTENDANCE_LATE_GRACE_MINUTES=15
ATTENDANCE_CODE_TTL_MINUTES=15
PASSWORD_RESET_CODE_TTL_MINUTES=30

GRADE_WEIGHT_MODULES=30
GRADE_WEIGHT_ACTIVITIES=40
GRADE_WEIGHT_ATTENDANCE=30

# Email delivery for verification codes (2FA, email/contact/password change,
# QR attendance). REQUIRED for real use — with SMTP_HOST empty no email is
# sent (local dev prints it to the backend console; production refuses).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=<the gmail address>, SMTP_PASS=<a 16-character Google App Password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MARSU NSTP Portal <no-reply@marsu.edu.ph>

# Timezone every date/time is computed in (default Asia/Manila, UTC+8).
APP_TIMEZONE=Asia/Manila

# Optional: secret for GET /api/cron/attendance-sweep (automatic absences),
# for an external scheduler. Send it as "Authorization: Bearer <secret>".
CRON_SECRET=
